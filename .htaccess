RewriteEngine On
RewriteBase /

DirectoryIndex index.php
Options -Indexes

# ── Block sensitive paths ──
RewriteRule ^(\.env|bootstrap\.php|migrate\.php|skills-lock\.json)$ - [F,L]
RewriteRule ^(app|config|migrations|database|\.agents)(/|$) - [F,L]

# ── Root path ──
RewriteRule ^$ index.php [L]

# ── Serve files from public/ ──
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.+)$ public/$1 [L]

# ── Front controller ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# ── Block hidden files ──
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
